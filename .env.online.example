# PostgreSQL local del servidor. Usá una contraseña larga y única.
POSTGRES_PASSWORD=change-this-long-random-password

# Supabase Auth. Para pruebas, usá un proyecto de Supabase o la URL/anon key
# de `supabase start`. Nunca pongas service_role en este archivo.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_BROWSER_URL=http://localhost:54321
SUPABASE_ANON_KEY=replace-with-your-anon-key

# Identificador estable de temporada compartida.
SEASON_ID=BETA-ONLINE-01
SEASON_ROSTER_SIZE=12
# UUID de Auth del administrador, obtenido del encabezado del portal. Acepta una lista separada por comas.
ADMIN_USER_IDS=

# localhost limita el servicio a esta PC. Para una LAN cerrada, cambiá a 0.0.0.0
# y completá ALLOWED_ORIGINS con el origen exacto que usarán los jugadores.
GAME_SERVER_BIND=127.0.0.1
ALLOWED_ORIGINS=http://localhost:8080
BOT_FILL_DELAY_MS=12000
MAX_WEBSOCKET_CONNECTIONS=1200
PLAYER_ACTIONS_PER_SECOND=12
PLAYER_ACTION_BURST=20
PLAYER_HTTP_REQUESTS_PER_MINUTE=300
MATCH_TICK_INTERVAL_MS=200
MATCH_EVENT_PERSIST_INTERVAL_MS=5000
STATE_BROADCAST_INTERVAL_MS=250
ALLOW_LOCAL_SAVE_IMPORT=false

# Dejá DATABASE_URL_OVERRIDE vacío para la base Docker local. Para cambiar a
# Supabase Postgres, coloca aquí la URI de modo sesión sin parámetros sslmode,
# sslcert, sslkey ni sslrootcert, y pon DATABASE_SSL=true.
DATABASE_URL_OVERRIDE=
DATABASE_SSL=false
DB_POOL_MAX=10
